{
  "id": "com.mattermost.plugin-readreceipts",
  "name": "Read Receipts",
  "description": "Статусы прочтения в духе официального дизайна Mattermost: галочки у времени сообщения и список прочитавших по клику.",
  "version": "0.4.0",
  "min_server_version": "11.9.0",
  "server": {
    "executables": {
      "linux-amd64": "server/dist/plugin-linux-amd64",
      "darwin-amd64": "server/dist/plugin-darwin-amd64",
      "windows-amd64": "server/dist/plugin-windows-amd64.exe"
    },
    "executable": ""
  },
  "webapp": {
    "bundle_path": "webapp/dist/main.js"
  },
  "settings_schema": {
    "header": "Настройки Read Receipts",
    "footer": "Настройки плагина отображения статусов прочтения сообщений",
    "settings": [
      {
        "key": "ChannelScope",
        "display_name": "Где показывать статусы",
        "type": "dropdown",
        "help_text": "«Только в ЛС и группах» повторяет официальный дизайн Mattermost: там, где участников мало и статус осмысленен. «Во всех каналах» — прежнее поведение плагина.",
        "default": "all",
        "options": [
          {
            "display_name": "Во всех каналах",
            "value": "all"
          },
          {
            "display_name": "Только в личных и групповых",
            "value": "direct"
          }
        ]
      },
      {
        "key": "DisplayLimit",
        "display_name": "Лимит отображения пользователей",
        "type": "number",
        "help_text": "Сколько человек показывать в окне списка, прежде чем появится кнопка «Показать ещё».",
        "placeholder": "10",
        "default": 10
      },
      {
        "key": "DisplayNameFormat",
        "display_name": "Формат отображения имени",
        "type": "dropdown",
        "help_text": "Как отображать имя пользователя в списке прочитавших.",
        "default": "fullname",
        "options": [
          {
            "display_name": "Фамилия и имя (или псевдоним/логин)",
            "value": "fullname"
          },
          {
            "display_name": "Псевдоним (или логин)",
            "value": "nickname"
          },
          {
            "display_name": "Логин",
            "value": "username"
          }
        ]
      },
      {
        "key": "PopupPosition",
        "display_name": "Позиция окна списка",
        "type": "dropdown",
        "help_text": "Где показывать окно со статусами относительно галочек. Если с выбранной стороны окно не помещается целиком, оно показывается с другой стороны — галочки окно не перекрывает никогда.",
        "default": "above",
        "options": [
          {
            "display_name": "Над галочками",
            "value": "above"
          },
          {
            "display_name": "Под галочками",
            "value": "below"
          },
          {
            "display_name": "Слева от галочек",
            "value": "left"
          },
          {
            "display_name": "Справа от галочек",
            "value": "right"
          }
        ]
      }
    ]
  }
}